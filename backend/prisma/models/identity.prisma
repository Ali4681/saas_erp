model User {
  id              String     @id @default(uuid(7)) @db.Char(36)
  fullName        String     @map("full_name") @db.VarChar(160)
  email           String?    @unique @db.VarChar(254)
  phone           String?    @unique @db.VarChar(40)
  passwordHash    String     @map("password_hash") @db.Text
  locale          String     @default("en") @db.VarChar(10)
  theme           String     @default("light") @db.VarChar(10)
  isPlatformAdmin Boolean    @default(false) @map("is_platform_admin")
  status          UserStatus @default(INVITED)
  totpSecretEnc   Bytes?     @map("totp_secret_enc") @db.VarBinary(512)
  totpEnabled     Boolean    @default(false) @map("totp_enabled")
  lastLoginAt     DateTime?  @map("last_login_at") @db.DateTime(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  memberships   CompanyUser[]
  sessions      UserSession[]
  refreshTokens RefreshToken[]
  notifications Notification[]
  auditLogs     AuditLog[]                  @relation("AuditActor")
  createdProjects ConnectedProject[]        @relation("ProjectCreator")
  operations    ProviderOperationRequest[]  @relation("OperationRequester")
  expenses      Expense[]                   @relation("ExpenseCreator")
  ownedCrmContacts CrmContact[]             @relation("CrmContactOwner")
  ownedOpportunities CrmOpportunity[]       @relation("CrmOpportunityOwner")
  assignedActivities CrmActivity[]          @relation("CrmActivityAssignee")
  createdActivities CrmActivity[]           @relation("CrmActivityCreator")
  createdQuotes SalesQuote[]                @relation("SalesQuoteCreator")
  approvedQuotes SalesQuote[]               @relation("SalesQuoteApprover")
  createdSalesInvoices SalesInvoice[]       @relation("SalesInvoiceCreator")
  requestedPurchaseOrders PurchaseOrder[]   @relation("PurchaseOrderRequester")
  approvedPurchaseOrders PurchaseOrder[]    @relation("PurchaseOrderApprover")
  createdStockMovements StockMovement[]     @relation("StockMovementCreator")
  createdStockCounts StockCount[]           @relation("StockCountCreator")
  approvedStockCounts StockCount[]          @relation("StockCountApprover")
  employees         Employee[]
  approvedLeaves    LeaveRequest[]          @relation("LeaveApprover")
  createdPayrollRuns PayrollRun[]           @relation("PayrollCreator")
  decidedSalaryAdvances SalaryAdvance[]     @relation("SalaryAdvanceDecider")
  approvedSalesSubmissions EmployeeSalesSubmission[] @relation("SalesSubmissionApprover")
  createdDailyClosings DailyCashClosing[]   @relation("DailyClosingCreator")
  closedDailyClosings DailyCashClosing[]    @relation("DailyClosingCloser")
  ownedWorkProjects WorkProject[]           @relation("WorkProjectOwner")
  workTaskComments  WorkTaskComment[]       @relation("WorkTaskCommentAuthor")
  createdAutomations AutomationRule[]       @relation("AutomationCreator")
  createdMarketingPosts MarketingPost[]     @relation("MarketingPostCreator")
  createdMarketingConnections MarketingPlatformConnection[] @relation("MarketingConnectionCreator")
  uploadedAttachments Attachment[]          @relation("AttachmentUploader")
  aiUsageLogs       AiUsageLog[]
  createdBusinessNotes BusinessNote[]       @relation("BusinessNoteCreator")
  businessNoteComments BusinessNoteComment[] @relation("BusinessNoteCommentAuthor")
  businessNoteRevisions BusinessNoteRevision[] @relation("BusinessNoteRevisionEditor")
  createdCompanyApiKeys CompanyApiKey[]     @relation("CompanyApiKeyCreator")
  createdCompanyWebhooks CompanyWebhook[]   @relation("CompanyWebhookCreator")
  createdPaymentMethods CompanyPaymentMethod[] @relation("CompanyPaymentMethodCreator")
  pushDevices       UserPushDevice[]

  @@index([status], map: "idx_users_status")
  @@map("users")
}

model CompanyUser {
  id           String     @id @default(uuid(7)) @db.Char(36)
  companyId    String     @map("company_id") @db.Char(36)
  userId       String     @map("user_id") @db.Char(36)
  roleId       String     @map("role_id") @db.Char(36)
  branchId     String?    @map("branch_id") @db.Char(36)
  departmentId String?    @map("department_id") @db.Char(36)
  status       UserStatus @default(ACTIVE)
  joinedAt     DateTime   @default(now()) @map("joined_at") @db.DateTime(3)

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user       User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch     CompanyBranch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department CompanyDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  workProjectMembers WorkProjectMember[]
  assignedTasks      WorkTask[]

  @@unique([companyId, userId], map: "uq_company_user")
  @@index([companyId, roleId, status], map: "idx_company_user_role_status")
  @@map("company_users")
}

model Role {
  id       String    @id @default(uuid(7)) @db.Char(36)
  code     String    @unique @db.VarChar(50)
  name     String    @db.VarChar(100)
  scope    RoleScope
  isSystem Boolean   @default(true) @map("is_system")

  permissions RolePermission[]
  memberships CompanyUser[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid(7)) @db.Char(36)
  code        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(60)
  action      String  @db.VarChar(40)
  description String? @db.Text

  roles RolePermission[]

  @@unique([module, action], map: "uq_permission_module_action")
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Char(36)
  permissionId String @map("permission_id") @db.Char(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "idx_role_permission_permission")
  @@map("role_permissions")
}

model UserSession {
  id               String    @id @default(uuid(7)) @db.Char(36)
  userId           String    @map("user_id") @db.Char(36)
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(128)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.Text
  expiresAt        DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt        DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "idx_user_session_user_expires")
  @@map("user_sessions")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "idx_refresh_token_user_expires")
  @@map("refresh_tokens")
}
