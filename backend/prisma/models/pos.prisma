/// Point of Sale terminals and assigned cashiers (tenant-owned).

model PointOfSale {
  id              String       @id @default(uuid(7)) @db.Char(36)
  companyId       String       @map("company_id") @db.Char(36)
  /// Optional link to company branch (POS ≈ branch location).
  companyBranchId String?      @map("company_branch_id") @db.Char(36)
  code            String       @db.VarChar(40)
  name            String       @db.VarChar(140)
  status          RecordStatus @default(ACTIVE)
  locationNote    String?      @map("location_note") @db.VarChar(240)
  templateCode    String?      @map("template_code") @db.VarChar(40)
  layoutJson      Json?        @map("layout_json")
  createdAt       DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch   CompanyBranch? @relation(fields: [companyBranchId], references: [id], onDelete: SetNull)
  cashiers PosCashier[]
  invoices SalesInvoice[]
  shiftSessions CashierShiftSession[]
  auditEvents PosAuditEvent[]

  @@unique([companyId, code], map: "uq_point_of_sale_code")
  @@index([companyId, status], map: "idx_point_of_sale_status")
  @@map("points_of_sale")
}

/// Cashier assignment: which employee/user may sell at a given POS.
model PosCashier {
  id            String       @id @default(uuid(7)) @db.Char(36)
  companyId     String       @map("company_id") @db.Char(36)
  pointOfSaleId String       @map("point_of_sale_id") @db.Char(36)
  employeeId    String       @map("employee_id") @db.Char(36)
  userId        String       @map("user_id") @db.Char(36)
  displayName   String?      @map("display_name") @db.VarChar(140)
  status        RecordStatus @default(ACTIVE)
  permissionsJson Json?      @map("permissions_json")
  createdAt     DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  pointOfSale PointOfSale @relation(fields: [pointOfSaleId], references: [id], onDelete: Cascade)
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  invoices    SalesInvoice[]
  auditEvents PosAuditEvent[]

  @@unique([pointOfSaleId, employeeId], map: "uq_pos_cashier_employee")
  @@unique([pointOfSaleId, userId], map: "uq_pos_cashier_user")
  @@index([companyId, status], map: "idx_pos_cashier_company_status")
  @@map("pos_cashiers")
}

model PosAuditEvent {
  id            String   @id @default(uuid(7)) @db.Char(36)
  companyId     String   @map("company_id") @db.Char(36)
  pointOfSaleId String?  @map("point_of_sale_id") @db.Char(36)
  posCashierId  String?  @map("pos_cashier_id") @db.Char(36)
  userId        String   @map("user_id") @db.Char(36)
  action        String   @db.VarChar(80)
  payloadJson   Json?    @map("payload_json")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  pointOfSale PointOfSale? @relation(fields: [pointOfSaleId], references: [id], onDelete: SetNull)
  cashier     PosCashier?  @relation(fields: [posCashierId], references: [id], onDelete: SetNull)
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt], map: "idx_pos_audit_company_created")
  @@map("pos_audit_events")
}
