model Employee {
  id                   String           @id @default(uuid(7)) @db.Char(36)
  companyId            String           @map("company_id") @db.Char(36)
  userId               String?          @map("user_id") @db.Char(36)
  /// MySQL null-unique substitute for optional user link
  userKey              String           @default("") @map("user_key") @db.Char(36)
  companyBranchId      String?          @map("company_branch_id") @db.Char(36)
  companyDepartmentId  String?          @map("company_department_id") @db.Char(36)
  employeeNumber       String           @map("employee_number") @db.VarChar(40)
  fullName             String           @map("full_name") @db.VarChar(180)
  email                String?          @db.VarChar(254)
  phone                String?          @db.VarChar(40)
  jobTitle             String?          @map("job_title") @db.VarChar(120)
  hireDate             DateTime?        @map("hire_date") @db.Date
  employmentStatus     EmploymentStatus @default(ACTIVE) @map("employment_status")
  basicSalary          Decimal?         @map("basic_salary") @db.Decimal(18, 2)
  /// Sales/ops target percent of salary (0–100) when employee has targets
  targetPercent        Decimal?         @map("target_percent") @db.Decimal(5, 2)
  /// How much of the target was achieved (0–100)
  targetCompletedPercent Decimal?       @map("target_completed_percent") @db.Decimal(5, 2)
  /// Fixed daily discount for unjustified ABSENT days
  absenceDiscountPerDay Decimal?        @map("absence_discount_per_day") @db.Decimal(18, 2)
  /// Fixed discount applied when attendance is LATE
  lateDiscountAmount   Decimal?         @map("late_discount_amount") @db.Decimal(18, 2)
  isPurchaseOperator   Boolean          @default(false) @map("is_purchase_operator")
  currency             String?          @db.Char(3)
  leaveBalanceDays     Decimal          @default(21) @map("leave_balance_days") @db.Decimal(8, 2)
  createdAt            DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch       CompanyBranch?      @relation(fields: [companyBranchId], references: [id], onDelete: SetNull)
  department   CompanyDepartment?  @relation(fields: [companyDepartmentId], references: [id], onDelete: SetNull)
  attendance   AttendanceRecord[]
  leaveRequests LeaveRequest[]
  payrollItems PayrollItem[]
  businessNotes BusinessNote[]
  salaryAdvances SalaryAdvance[]
  contracts      EmployeeContract[]
  ewallet        EmployeeEwallet?

  @@unique([companyId, employeeNumber], map: "uq_employee_number")
  @@index([companyId, userId], map: "idx_employee_company_user")
  @@index([companyId, employmentStatus], map: "idx_employee_status")
  @@map("employees")
}

model EmployeeContract {
  id             String                 @id @default(uuid(7)) @db.Char(36)
  companyId      String                 @map("company_id") @db.Char(36)
  employeeId     String                 @map("employee_id") @db.Char(36)
  title          String                 @db.VarChar(180)
  contractNumber String?                @map("contract_number") @db.VarChar(80)
  status         EmployeeContractStatus @default(DRAFT)
  startsOn       DateTime?              @map("starts_on") @db.Date
  endsOn         DateTime?              @map("ends_on") @db.Date
  baseSalary     Decimal?               @map("base_salary") @db.Decimal(18, 2)
  targetPercent  Decimal?               @map("target_percent") @db.Decimal(5, 2)
  notes          String?                @db.Text
  submittedAt    DateTime?              @map("submitted_at") @db.DateTime(3)
  createdAt      DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([companyId, employeeId, status], map: "idx_employee_contract_status")
  @@map("employee_contracts")
}

model SalaryAdvance {
  id           String              @id @default(uuid(7)) @db.Char(36)
  companyId    String              @map("company_id") @db.Char(36)
  employeeId   String              @map("employee_id") @db.Char(36)
  amount       Decimal             @db.Decimal(18, 2)
  currency     String              @db.Char(3)
  reason       String?             @db.Text
  status       SalaryAdvanceStatus @default(PENDING)
  requestedAt  DateTime            @default(now()) @map("requested_at") @db.DateTime(3)
  decidedAt    DateTime?           @map("decided_at") @db.DateTime(3)
  decidedById  String?             @map("decided_by") @db.Char(36)
  paidAt       DateTime?           @map("paid_at") @db.DateTime(3)
  createdAt    DateTime            @default(now()) @map("created_at") @db.DateTime(3)

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  decidedBy User?    @relation("SalaryAdvanceDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([companyId, status, requestedAt], map: "idx_salary_advance_status")
  @@index([employeeId, status], map: "idx_salary_advance_employee")
  @@map("salary_advances")
}

model EmployeeEwallet {
  id            String               @id @default(uuid(7)) @db.Char(36)
  companyId     String               @map("company_id") @db.Char(36)
  employeeId    String               @unique @map("employee_id") @db.Char(36)
  walletCode    String               @map("wallet_code") @db.VarChar(40)
  balance       Decimal              @default(0) @db.Decimal(18, 2)
  currency      String               @db.Char(3)
  status        EmployeeEwalletStatus @default(ACTIVE)
  createdAt     DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.DateTime(3)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([companyId, walletCode], map: "uq_employee_ewallet_code")
  @@index([companyId, status], map: "idx_employee_ewallet_status")
  @@map("employee_ewallets")
}

model AttendanceDevice {
  id          String                 @id @default(uuid(7)) @db.Char(36)
  companyId   String                 @map("company_id") @db.Char(36)
  name        String                 @db.VarChar(140)
  deviceType  AttendanceDeviceType   @map("device_type")
  status      AttendanceDeviceStatus @default(ACTIVE)
  location    String?                @db.VarChar(180)
  /// Shared secret / API key for device punches (stored hashed in production later)
  deviceKey   String                 @map("device_key") @db.VarChar(80)
  streamUrl   String?                @map("stream_url") @db.VarChar(500)
  lastSeenAt  DateTime?              @map("last_seen_at") @db.DateTime(3)
  createdAt   DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  company Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  events  AttendanceDeviceEvent[]

  @@unique([companyId, deviceKey], map: "uq_attendance_device_key")
  @@index([companyId, status], map: "idx_attendance_device_status")
  @@map("attendance_devices")
}

model AttendanceDeviceEvent {
  id         String   @id @default(uuid(7)) @db.Char(36)
  companyId  String   @map("company_id") @db.Char(36)
  deviceId   String   @map("device_id") @db.Char(36)
  employeeId String?  @map("employee_id") @db.Char(36)
  /// External badge / biometric id from the machine
  externalRef String? @map("external_ref") @db.VarChar(120)
  eventType  String   @map("event_type") @db.VarChar(40)
  occurredAt DateTime @map("occurred_at") @db.DateTime(3)
  payload    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  company Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  device  AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([companyId, occurredAt], map: "idx_attendance_device_event_time")
  @@index([deviceId, occurredAt], map: "idx_attendance_device_event_device")
  @@map("attendance_device_events")
}

model AttendanceRecord {
  id             String           @id @default(uuid(7)) @db.Char(36)
  companyId      String           @map("company_id") @db.Char(36)
  employeeId     String           @map("employee_id") @db.Char(36)
  attendanceDate DateTime         @map("attendance_date") @db.Date
  checkInAt      DateTime?        @map("check_in_at") @db.DateTime(3)
  checkOutAt     DateTime?        @map("check_out_at") @db.DateTime(3)
  status         AttendanceStatus
  workedMinutes  Int?             @map("worked_minutes")
  source         String?          @db.VarChar(40)
  notes          String?          @db.Text

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, attendanceDate], map: "uq_attendance_employee_date")
  @@index([companyId, attendanceDate], map: "idx_attendance_company_date")
  @@map("attendance_records")
}

model LeaveRequest {
  id            String      @id @default(uuid(7)) @db.Char(36)
  companyId     String      @map("company_id") @db.Char(36)
  employeeId    String      @map("employee_id") @db.Char(36)
  leaveType     String      @map("leave_type") @db.VarChar(60)
  startsOn      DateTime    @map("starts_on") @db.Date
  endsOn        DateTime    @map("ends_on") @db.Date
  requestedDays Decimal     @map("requested_days") @db.Decimal(6, 2)
  status        LeaveStatus @default(PENDING)
  reason        String?     @db.Text
  approvedById  String?     @map("approved_by") @db.Char(36)
  decidedAt     DateTime?   @map("decided_at") @db.DateTime(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.DateTime(3)

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  approvedBy User?    @relation("LeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([companyId, status, startsOn], map: "idx_leave_company_status_start")
  @@map("leave_requests")
}

model PayrollRun {
  id              String        @id @default(uuid(7)) @db.Char(36)
  companyId       String        @map("company_id") @db.Char(36)
  periodStart     DateTime      @map("period_start") @db.Date
  periodEnd       DateTime      @map("period_end") @db.Date
  status          PayrollStatus @default(DRAFT)
  totalGross      Decimal       @default(0) @map("total_gross") @db.Decimal(18, 2)
  totalDeductions Decimal       @default(0) @map("total_deductions") @db.Decimal(18, 2)
  totalNet        Decimal       @default(0) @map("total_net") @db.Decimal(18, 2)
  processedAt     DateTime?     @map("processed_at") @db.DateTime(3)
  createdById     String        @map("created_by") @db.Char(36)
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(3)

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy User          @relation("PayrollCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items     PayrollItem[]

  @@unique([companyId, periodStart, periodEnd], map: "uq_payroll_run_period")
  @@map("payroll_runs")
}

model PayrollItem {
  id          String            @id @default(uuid(7)) @db.Char(36)
  payrollRunId String           @map("payroll_run_id") @db.Char(36)
  employeeId  String            @map("employee_id") @db.Char(36)
  basicSalary Decimal           @map("basic_salary") @db.Decimal(18, 2)
  allowances  Decimal           @default(0) @db.Decimal(18, 2)
  bonuses     Decimal           @default(0) @db.Decimal(18, 2)
  deductions  Decimal           @default(0) @db.Decimal(18, 2)
  advances    Decimal           @default(0) @db.Decimal(18, 2)
  netAmount   Decimal           @map("net_amount") @db.Decimal(18, 2)
  status      PayrollItemStatus @default(DRAFT)

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([payrollRunId, employeeId], map: "uq_payroll_item_run_employee")
  @@map("payroll_items")
}
