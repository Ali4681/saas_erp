model ItemCategory {
  id                 String       @id @default(uuid(7)) @db.Char(36)
  companyId          String       @map("company_id") @db.Char(36)
  parentId           String?      @map("parent_id") @db.Char(36)
  code               String?      @db.VarChar(40)
  codeKey            String       @default("") @map("code_key") @db.VarChar(40)
  name               String       @db.VarChar(140)
  status             RecordStatus @default(ACTIVE)
  /// Inherited VAT % for child items when item.taxRate is null/0 and inheritTax=true
  inheritedTaxRate   Decimal?     @map("inherited_tax_rate") @db.Decimal(5, 2)
  /// Default custom attribute keys/values applied to new items in this category
  inheritedAttributes Json        @default("{}") @map("inherited_attributes")
  /// ABC class for cycle counting: A | B | C
  abcClass           String?      @map("abc_class") @db.VarChar(1)
  shelfLifeDaysAlert Int?         @map("shelf_life_days_alert") @db.SmallInt

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent      ItemCategory?        @relation("ItemCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    ItemCategory[]       @relation("ItemCategoryTree")
  items       Item[]
  itemLinks   ItemCategoryLink[]
  attributeDefs ItemAttributeDef[]

  @@unique([companyId, codeKey], map: "uq_item_category_company_code")
  @@index([companyId, status], map: "idx_item_category_status")
  @@map("item_categories")
}

model Unit {
  id            String @id @default(uuid(7)) @db.Char(36)
  companyId     String @map("company_id") @db.Char(36)
  code          String @db.VarChar(20)
  name          String @db.VarChar(80)
  decimalPlaces Int    @default(0) @map("decimal_places") @db.SmallInt

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  items       Item[]
  conversions ItemUnitConversion[]
  barcodes    ItemBarcode[]

  @@unique([companyId, code], map: "uq_unit_company_code")
  @@map("units")
}

model Item {
  id             String       @id @default(uuid(7)) @db.Char(36)
  companyId      String       @map("company_id") @db.Char(36)
  itemCategoryId String?      @map("item_category_id") @db.Char(36)
  /// Parent item when this is a sub-item / variant
  parentItemId   String?      @map("parent_item_id") @db.Char(36)
  unitId         String       @map("unit_id") @db.Char(36)
  sku            String?      @db.VarChar(120)
  skuKey         String       @default("") @map("sku_key") @db.VarChar(120)
  barcode        String?      @db.VarChar(120)
  barcodeKey     String       @default("") @map("barcode_key") @db.VarChar(120)
  name           String       @db.VarChar(220)
  status         RecordStatus @default(ACTIVE)
  cost           Decimal?     @db.Decimal(18, 2)
  salePrice      Decimal?     @map("sale_price") @db.Decimal(18, 2)
  minStock       Decimal      @default(0) @map("min_stock") @db.Decimal(18, 3)
  reorderQty     Decimal      @default(0) @map("reorder_qty") @db.Decimal(18, 3)
  supplySource   ItemSupplySource @default(LOCAL) @map("supply_source")
  preferredSupplierId String? @map("preferred_supplier_id") @db.Char(36)
  inventoryAccountId String?  @map("inventory_account_id") @db.Char(36)
  taxRate        Decimal      @default(0) @map("tax_rate") @db.Decimal(5, 2)
  inheritTaxFromCategory Boolean @default(true) @map("inherit_tax_from_category")
  isMatrixParent Boolean      @default(false) @map("is_matrix_parent")
  matrixAxes     Json?        @map("matrix_axes")
  trackSerial    Boolean      @default(false) @map("track_serial")
  trackBatch     Boolean      @default(false) @map("track_batch")
  netWeightKg    Decimal?     @map("net_weight_kg") @db.Decimal(18, 4)
  grossWeightKg  Decimal?     @map("gross_weight_kg") @db.Decimal(18, 4)
  volumeCbm      Decimal?     @map("volume_cbm") @db.Decimal(18, 6)
  abcClass       String?      @map("abc_class") @db.VarChar(1)
  slowMovingDays Int?         @map("slow_moving_days") @db.SmallInt
  nameAr         String?      @map("name_ar") @db.VarChar(220)
  nameEn         String?      @map("name_en") @db.VarChar(220)
  /// Primary product photo (AI studio / manual upload)
  imageAttachmentId String?   @map("image_attachment_id") @db.Char(36)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  company           Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category          ItemCategory?       @relation(fields: [itemCategoryId], references: [id], onDelete: SetNull)
  parentItem        Item?               @relation("ItemTree", fields: [parentItemId], references: [id], onDelete: SetNull)
  childItems        Item[]              @relation("ItemTree")
  unit              Unit                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  balances          StockBalance[]
  movements         StockMovement[]
  countItems        StockCountItem[]
  quoteItems        SalesQuoteItem[]
  invoiceItems      SalesInvoiceItem[]
  purchaseOrderItems PurchaseOrderItem[]
  billItems         SupplierBillItem[]
  requisitionItems  PurchaseRequisitionItem[]
  goodsReceiptItems GoodsReceiptItem[]
  preferredSupplier Supplier?           @relation("ItemPreferredSupplier", fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  inventoryAccount  GlAccount?          @relation("ItemInventoryAccount", fields: [inventoryAccountId], references: [id], onDelete: SetNull)
  priceListEntries  PriceListEntry[]
  supportTickets    SupportTicket[]
  bundleItems       ProductBundleItem[]
  categoryLinks     ItemCategoryLink[]
  relationsFrom     ItemRelation[]      @relation("ItemRelationFrom")
  relationsTo       ItemRelation[]      @relation("ItemRelationTo")
  attributeValues   ItemAttributeValue[]
  unitConversions   ItemUnitConversion[]
  barcodes          ItemBarcode[]
  batches           ItemBatch[]
  serials           ItemSerial[]
  transferLines     StockTransferItem[]
  reservations      StockReservation[]
  adjustmentLines   StockAdjustmentItem[]

  @@unique([companyId, skuKey], map: "uq_item_company_sku")
  @@unique([companyId, barcodeKey], map: "uq_item_company_barcode")
  @@index([companyId, status], map: "idx_item_company_status")
  @@index([companyId, parentItemId], map: "idx_item_parent")
  @@map("items")
}

model Warehouse {
  id              String       @id @default(uuid(7)) @db.Char(36)
  companyId       String       @map("company_id") @db.Char(36)
  companyBranchId String?      @map("company_branch_id") @db.Char(36)
  code            String       @db.VarChar(40)
  name            String       @db.VarChar(140)
  status          RecordStatus @default(ACTIVE)
  addressLine     String?      @map("address_line") @db.Text
  isSellable      Boolean      @default(true) @map("is_sellable")
  warehouseKind   String       @default("STANDARD") @map("warehouse_kind") @db.VarChar(40)

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch          CompanyBranch?   @relation(fields: [companyBranchId], references: [id], onDelete: SetNull)
  balances        StockBalance[]
  movements       StockMovement[]
  counts          StockCount[]
  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]
  transfersFrom   StockTransfer[]    @relation("TransferFromWarehouse")
  transfersTo     StockTransfer[]    @relation("TransferToWarehouse")
  reservations    StockReservation[]
  adjustments     StockAdjustment[]

  @@unique([companyId, code], map: "uq_warehouse_company_code")
  @@index([companyId, status], map: "idx_warehouse_company_status")
  @@map("warehouses")
}

model StockBalance {
  warehouseId      String   @map("warehouse_id") @db.Char(36)
  itemId           String   @map("item_id") @db.Char(36)
  quantityOnHand   Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(18, 3)
  quantityReserved Decimal  @default(0) @map("quantity_reserved") @db.Decimal(18, 3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([warehouseId, itemId])
  @@map("stock_balances")
}

model StockMovement {
  id            String            @id @default(uuid(7)) @db.Char(36)
  companyId     String            @map("company_id") @db.Char(36)
  warehouseId   String            @map("warehouse_id") @db.Char(36)
  itemId        String            @map("item_id") @db.Char(36)
  movementType  StockMovementType @map("movement_type")
  quantity      Decimal           @db.Decimal(18, 3)
  unitCost      Decimal?          @map("unit_cost") @db.Decimal(18, 2)
  referenceType String?           @map("reference_type") @db.VarChar(60)
  referenceId   String?           @map("reference_id") @db.Char(36)
  occurredAt    DateTime          @map("occurred_at") @db.DateTime(3)
  createdById   String            @map("created_by") @db.Char(36)
  notes         String?           @db.Text
  createdAt     DateTime          @default(now()) @map("created_at") @db.DateTime(3)

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  createdBy User      @relation("StockMovementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId, warehouseId, itemId, occurredAt], map: "idx_stock_movement_wh_item_time")
  @@map("stock_movements")
}

model StockCount {
  id              String           @id @default(uuid(7)) @db.Char(36)
  companyId       String           @map("company_id") @db.Char(36)
  warehouseId     String           @map("warehouse_id") @db.Char(36)
  countNumber     String           @map("count_number") @db.VarChar(60)
  status          StockCountStatus @default(DRAFT)
  /// Set while DRAFT/IN_PROGRESS for one-open-count-per-warehouse
  openWarehouseId String?          @unique @map("open_warehouse_id") @db.Char(36)
  startedAt       DateTime         @map("started_at") @db.DateTime(3)
  completedAt     DateTime?        @map("completed_at") @db.DateTime(3)
  createdById     String           @map("created_by") @db.Char(36)
  approvedById    String?          @map("approved_by") @db.Char(36)

  company    Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouse  Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy  User             @relation("StockCountCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?            @relation("StockCountApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  items      StockCountItem[]

  @@unique([companyId, countNumber], map: "uq_stock_count_number")
  @@map("stock_counts")
}

model StockCountItem {
  id              String   @id @default(uuid(7)) @db.Char(36)
  stockCountId    String   @map("stock_count_id") @db.Char(36)
  itemId          String   @map("item_id") @db.Char(36)
  systemQuantity  Decimal  @map("system_quantity") @db.Decimal(18, 3)
  countedQuantity Decimal? @map("counted_quantity") @db.Decimal(18, 3)
  varianceQuantity Decimal? @map("variance_quantity") @db.Decimal(18, 3)
  notes           String?  @db.Text

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  item       Item       @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, itemId], map: "uq_stock_count_item")
  @@map("stock_count_items")
}

/// Multi-path categorization (item under many category trees)
model ItemCategoryLink {
  id         String @id @default(uuid(7)) @db.Char(36)
  companyId  String @map("company_id") @db.Char(36)
  itemId     String @map("item_id") @db.Char(36)
  categoryId String @map("category_id") @db.Char(36)
  isPrimary  Boolean @default(false) @map("is_primary")

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  item     Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  category ItemCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([itemId, categoryId], map: "uq_item_category_link")
  @@index([companyId, categoryId], map: "idx_item_category_link_cat")
  @@map("item_category_links")
}

/// SUBSTITUTE | CROSS_SELL | COMPLEMENT
model ItemRelation {
  id           String @id @default(uuid(7)) @db.Char(36)
  companyId    String @map("company_id") @db.Char(36)
  fromItemId   String @map("from_item_id") @db.Char(36)
  toItemId     String @map("to_item_id") @db.Char(36)
  relationType String @map("relation_type") @db.VarChar(40)
  priority     Int    @default(0)

  company  Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  fromItem Item    @relation("ItemRelationFrom", fields: [fromItemId], references: [id], onDelete: Cascade)
  toItem   Item    @relation("ItemRelationTo", fields: [toItemId], references: [id], onDelete: Cascade)

  @@unique([fromItemId, toItemId, relationType], map: "uq_item_relation")
  @@index([companyId, fromItemId], map: "idx_item_relation_from")
  @@map("item_relations")
}

model ItemAttributeDef {
  id         String  @id @default(uuid(7)) @db.Char(36)
  companyId  String  @map("company_id") @db.Char(36)
  categoryId String? @map("category_id") @db.Char(36)
  code       String  @db.VarChar(60)
  name       String  @db.VarChar(120)
  dataType   String  @default("TEXT") @map("data_type") @db.VarChar(20)
  isRequired Boolean @default(false) @map("is_required")
  optionsJson Json?  @map("options_json")

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category ItemCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  values   ItemAttributeValue[]

  @@unique([companyId, code], map: "uq_item_attr_def_code")
  @@map("item_attribute_defs")
}

model ItemAttributeValue {
  id            String @id @default(uuid(7)) @db.Char(36)
  itemId        String @map("item_id") @db.Char(36)
  attributeDefId String @map("attribute_def_id") @db.Char(36)
  valueText     String @map("value_text") @db.VarChar(500)

  item      Item             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  attribute ItemAttributeDef @relation(fields: [attributeDefId], references: [id], onDelete: Cascade)

  @@unique([itemId, attributeDefId], map: "uq_item_attr_value")
  @@map("item_attribute_values")
}

/// Nested packaging: factor = how many base units in this unit
model ItemUnitConversion {
  id              String  @id @default(uuid(7)) @db.Char(36)
  companyId       String  @map("company_id") @db.Char(36)
  itemId          String  @map("item_id") @db.Char(36)
  unitId          String  @map("unit_id") @db.Char(36)
  factorToBase    Decimal @map("factor_to_base") @db.Decimal(18, 6)
  barcode         String? @db.VarChar(120)
  isSellUnit      Boolean @default(false) @map("is_sell_unit")
  isPurchaseUnit  Boolean @default(false) @map("is_purchase_unit")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  item    Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unit    Unit    @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([itemId, unitId], map: "uq_item_unit_conversion")
  @@map("item_unit_conversions")
}

/// RETAIL | LOGISTIC | SUPPLIER | SERIAL
model ItemBarcode {
  id        String  @id @default(uuid(7)) @db.Char(36)
  companyId String  @map("company_id") @db.Char(36)
  itemId    String  @map("item_id") @db.Char(36)
  barcode   String  @db.VarChar(120)
  barcodeType String @default("RETAIL") @map("barcode_type") @db.VarChar(40)
  unitId    String? @map("unit_id") @db.Char(36)
  isPrimary Boolean @default(false) @map("is_primary")
  payloadJson Json? @map("payload_json")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  item    Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unit    Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@unique([companyId, barcode], map: "uq_item_barcode_company")
  @@index([itemId], map: "idx_item_barcode_item")
  @@map("item_barcodes")
}

model ItemBatch {
  id          String    @id @default(uuid(7)) @db.Char(36)
  companyId   String    @map("company_id") @db.Char(36)
  itemId      String    @map("item_id") @db.Char(36)
  batchNumber String    @map("batch_number") @db.VarChar(80)
  manufacturedOn DateTime? @map("manufactured_on") @db.Date
  expiresOn   DateTime? @map("expires_on") @db.Date
  quantity    Decimal   @default(0) @db.Decimal(18, 3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  item    Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([companyId, itemId, batchNumber], map: "uq_item_batch")
  @@index([companyId, expiresOn], map: "idx_item_batch_expiry")
  @@map("item_batches")
}

model ItemSerial {
  id           String  @id @default(uuid(7)) @db.Char(36)
  companyId    String  @map("company_id") @db.Char(36)
  itemId       String  @map("item_id") @db.Char(36)
  serialNumber String  @map("serial_number") @db.VarChar(120)
  status       String  @default("IN_STOCK") @db.VarChar(40)
  warehouseId  String? @map("warehouse_id") @db.Char(36)
  soldInvoiceId String? @map("sold_invoice_id") @db.Char(36)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  item    Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([companyId, serialNumber], map: "uq_item_serial")
  @@index([itemId, status], map: "idx_item_serial_status")
  @@map("item_serials")
}

model StockTransfer {
  id               String @id @default(uuid(7)) @db.Char(36)
  companyId        String @map("company_id") @db.Char(36)
  transferNumber   String @map("transfer_number") @db.VarChar(60)
  fromWarehouseId  String @map("from_warehouse_id") @db.Char(36)
  toWarehouseId    String @map("to_warehouse_id") @db.Char(36)
  status           String @default("DRAFT") @db.VarChar(40)
  requestedById    String @map("requested_by") @db.Char(36)
  shippedAt        DateTime? @map("shipped_at") @db.DateTime(3)
  receivedAt       DateTime? @map("received_at") @db.DateTime(3)
  notes            String? @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)

  company       Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  fromWarehouse Warehouse @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  requestedBy   User      @relation("StockTransferRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  items         StockTransferItem[]

  @@unique([companyId, transferNumber], map: "uq_stock_transfer_number")
  @@index([companyId, status], map: "idx_stock_transfer_status")
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String  @id @default(uuid(7)) @db.Char(36)
  transferId String  @map("transfer_id") @db.Char(36)
  itemId     String  @map("item_id") @db.Char(36)
  quantity   Decimal @db.Decimal(18, 3)
  quantityReceived Decimal? @map("quantity_received") @db.Decimal(18, 3)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([transferId], map: "idx_stock_transfer_item")
  @@map("stock_transfer_items")
}

model StockReservation {
  id           String    @id @default(uuid(7)) @db.Char(36)
  companyId    String    @map("company_id") @db.Char(36)
  warehouseId  String    @map("warehouse_id") @db.Char(36)
  itemId       String    @map("item_id") @db.Char(36)
  quantity     Decimal   @db.Decimal(18, 3)
  sourceType   String    @map("source_type") @db.VarChar(60)
  sourceId     String    @map("source_id") @db.Char(36)
  status       String    @default("ACTIVE") @db.VarChar(40)
  expiresAt    DateTime? @map("expires_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  releasedAt   DateTime? @map("released_at") @db.DateTime(3)

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([companyId, status, expiresAt], map: "idx_stock_reservation_exp")
  @@index([warehouseId, itemId, status], map: "idx_stock_reservation_wh_item")
  @@map("stock_reservations")
}

model StockAdjustment {
  id             String @id @default(uuid(7)) @db.Char(36)
  companyId      String @map("company_id") @db.Char(36)
  warehouseId    String @map("warehouse_id") @db.Char(36)
  adjustmentNumber String @map("adjustment_number") @db.VarChar(60)
  reasonCode     String @map("reason_code") @db.VarChar(40)
  status         String @default("DRAFT") @db.VarChar(40)
  notes          String? @db.Text
  requestedById  String @map("requested_by") @db.Char(36)
  approvedById   String? @map("approved_by") @db.Char(36)
  secondApproverId String? @map("second_approver_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  approvedAt     DateTime? @map("approved_at") @db.DateTime(3)

  company     Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  requestedBy User @relation("StockAdjustmentRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User? @relation("StockAdjustmentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  items       StockAdjustmentItem[]

  @@unique([companyId, adjustmentNumber], map: "uq_stock_adjustment_number")
  @@index([companyId, status], map: "idx_stock_adjustment_status")
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id           String  @id @default(uuid(7)) @db.Char(36)
  adjustmentId String  @map("adjustment_id") @db.Char(36)
  itemId       String  @map("item_id") @db.Char(36)
  quantityDelta Decimal @map("quantity_delta") @db.Decimal(18, 3)
  unitCost     Decimal? @map("unit_cost") @db.Decimal(18, 2)

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  item       Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([adjustmentId], map: "idx_stock_adjustment_item")
  @@map("stock_adjustment_items")
}

model LabelTemplate {
  id          String  @id @default(uuid(7)) @db.Char(36)
  companyId   String  @map("company_id") @db.Char(36)
  code        String  @db.VarChar(40)
  name        String  @db.VarChar(120)
  industryKey String? @map("industry_key") @db.VarChar(60)
  widthMm     Int     @default(50) @map("width_mm")
  heightMm    Int     @default(30) @map("height_mm")
  layoutJson  Json    @default("{}") @map("layout_json")
  isDefault   Boolean @default(false) @map("is_default")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code], map: "uq_label_template_code")
  @@map("label_templates")
}

model InvoicePrintTemplate {
  id         String  @id @default(uuid(7)) @db.Char(36)
  companyId  String  @map("company_id") @db.Char(36)
  code       String  @db.VarChar(40)
  name       String  @db.VarChar(120)
  layoutKind String  @map("layout_kind") @db.VarChar(40)
  bodyHtml   String? @map("body_html") @db.LongText
  isDefault  Boolean @default(false) @map("is_default")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code], map: "uq_invoice_print_template")
  @@map("invoice_print_templates")
}

model LandedCostAllocation {
  id              String  @id @default(uuid(7)) @db.Char(36)
  companyId       String  @map("company_id") @db.Char(36)
  purchaseOrderId String  @map("purchase_order_id") @db.Char(36)
  goodsReceiptId  String? @map("goods_receipt_id") @db.Char(36)
  totalLanded     Decimal @map("total_landed") @db.Decimal(18, 2)
  allocationJson  Json    @map("allocation_json")
  createdById     String  @map("created_by") @db.Char(36)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, purchaseOrderId], map: "idx_landed_cost_po")
  @@map("landed_cost_allocations")
}
