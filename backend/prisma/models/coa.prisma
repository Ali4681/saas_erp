/// Chart of Accounts + GL mapping + procure-to-pay extensions
/// See docs/CHART_OF_ACCOUNTS_AND_PURCHASING.md

model GlAccount {
  id          String        @id @default(uuid(7)) @db.Char(36)
  companyId   String        @map("company_id") @db.Char(36)
  code        String        @db.VarChar(20)
  nameAr      String        @map("name_ar") @db.VarChar(220)
  nameEn      String        @map("name_en") @db.VarChar(220)
  accountType GlAccountType @map("account_type")
  /// Normal balance side
  normalBalance GlNormalBalance @default(DEBIT) @map("normal_balance")
  parentId    String?       @map("parent_id") @db.Char(36)
  level       Int           @default(1) @db.SmallInt
  isPostable  Boolean       @default(true) @map("is_postable")
  /// Contra accounts (allowances, accumulated depreciation, returns)
  isContra    Boolean       @default(false) @map("is_contra")
  isActive    Boolean       @default(true) @map("is_active")
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   GlAccount?  @relation("GlAccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children GlAccount[] @relation("GlAccountTree")
  journalLines JournalLine[]
  itemsInventory Item[] @relation("ItemInventoryAccount")

  @@unique([companyId, code], map: "uq_gl_account_company_code")
  @@index([companyId, accountType, isActive], map: "idx_gl_account_type")
  @@index([companyId, parentId], map: "idx_gl_account_parent")
  @@map("gl_accounts")
}

/// Per-company automatic posting targets (sales / purchases / wallets).
model CompanyAccountMapping {
  id        String   @id @default(uuid(7)) @db.Char(36)
  companyId String   @unique @map("company_id") @db.Char(36)

  salesRevenueCode           String @default("411000") @map("sales_revenue_code") @db.VarChar(20)
  salesVatPayableCode        String @default("212100") @map("sales_vat_payable_code") @db.VarChar(20)
  salesCashPosCode           String @default("111200") @map("sales_cash_pos_code") @db.VarChar(20)
  salesCardBankCode          String @default("111300") @map("sales_card_bank_code") @db.VarChar(20)

  /// B2B credit sales receivable targets
  salesArLocalCode          String @default("112100") @map("sales_ar_local_code") @db.VarChar(20)
  salesArInternationalCode  String @default("112200") @map("sales_ar_international_code") @db.VarChar(20)

  inventoryGoodsCode         String @default("113100") @map("inventory_goods_code") @db.VarChar(20)
  inventoryInTransitCode     String @default("113500") @map("inventory_in_transit_code") @db.VarChar(20)
  inventoryShrinkageCode     String @default("514000") @map("inventory_shrinkage_code") @db.VarChar(20)
  apLocalCode                String @default("211100") @map("ap_local_code") @db.VarChar(20)
  apInternationalCode        String @default("211200") @map("ap_international_code") @db.VarChar(20)
  importLandingCostCode      String @default("512000") @map("import_landing_cost_code") @db.VarChar(20)
  cogsCode                   String @default("511000") @map("cogs_code") @db.VarChar(20)

  corporateWalletCode        String @default("111500") @map("corporate_wallet_code") @db.VarChar(20)
  employeeAdvanceCode        String @default("114100") @map("employee_advance_code") @db.VarChar(20)
  pettyCashExpenseCode       String @default("522400") @map("petty_cash_expense_code") @db.VarChar(20)

  mainTreasuryCode           String @default("111100") @map("main_treasury_code") @db.VarChar(20)
  customerStoreCreditCode    String @default("214100") @map("customer_store_credit_code") @db.VarChar(20)
  loyaltyLiabilityCode       String @default("214200") @map("loyalty_liability_code") @db.VarChar(20)
  salesDiscountCode          String @default("415000") @map("sales_discount_code") @db.VarChar(20)
  channelCommissionCode      String @default("524300") @map("channel_commission_code") @db.VarChar(20)
  bnplReceivableCode         String @default("112500") @map("bnpl_receivable_code") @db.VarChar(20)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_account_mappings")
}

model PurchaseRequisition {
  id              String                     @id @default(uuid(7)) @db.Char(36)
  companyId       String                     @map("company_id") @db.Char(36)
  requisitionNumber String                   @map("requisition_number") @db.VarChar(60)
  status          PurchaseRequisitionStatus  @default(DRAFT)
  demandSource    PurchaseDemandSource       @default(BRANCH_REQUISITION) @map("demand_source")
  companyBranchId String?                    @map("company_branch_id") @db.Char(36)
  requestedById   String                     @map("requested_by") @db.Char(36)
  approvedById    String?                    @map("approved_by") @db.Char(36)
  notes           String?                    @db.Text
  neededBy        DateTime?                  @map("needed_by") @db.Date
  createdAt       DateTime                   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.DateTime(3)

  company     Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch      CompanyBranch?            @relation(fields: [companyBranchId], references: [id], onDelete: SetNull)
  requestedBy User                      @relation("PurchaseRequisitionRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User?                     @relation("PurchaseRequisitionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  items       PurchaseRequisitionItem[]
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, requisitionNumber], map: "uq_purchase_requisition_number")
  @@index([companyId, status], map: "idx_purchase_requisition_status")
  @@map("purchase_requisitions")
}

model PurchaseRequisitionItem {
  id             String  @id @default(uuid(7)) @db.Char(36)
  requisitionId  String  @map("requisition_id") @db.Char(36)
  itemId         String? @map("item_id") @db.Char(36)
  description    String  @db.VarChar(240)
  quantity       Decimal @db.Decimal(18, 3)
  estimatedUnitCost Decimal? @map("estimated_unit_cost") @db.Decimal(18, 2)
  position       Int     @db.SmallInt

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  item        Item?               @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@unique([requisitionId, position], map: "uq_pr_item_position")
  @@map("purchase_requisition_items")
}

/// Goods Receipt Note (إذن إدخال مخزني) — basis for 3-way matching.
model GoodsReceipt {
  id              String            @id @default(uuid(7)) @db.Char(36)
  companyId       String            @map("company_id") @db.Char(36)
  purchaseOrderId String            @map("purchase_order_id") @db.Char(36)
  warehouseId     String            @map("warehouse_id") @db.Char(36)
  receiptNumber   String            @map("receipt_number") @db.VarChar(60)
  status          GoodsReceiptStatus @default(POSTED)
  receivedOn      DateTime          @map("received_on") @db.Date
  receivedById    String            @map("received_by") @db.Char(36)
  notes           String?           @db.Text
  createdAt       DateTime          @default(now()) @map("created_at") @db.DateTime(3)

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  receivedBy    User               @relation("GoodsReceiptReceiver", fields: [receivedById], references: [id], onDelete: Restrict)
  items         GoodsReceiptItem[]
  bills         SupplierBill[]

  @@unique([companyId, receiptNumber], map: "uq_goods_receipt_number")
  @@index([companyId, purchaseOrderId], map: "idx_goods_receipt_po")
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id              String  @id @default(uuid(7)) @db.Char(36)
  goodsReceiptId  String  @map("goods_receipt_id") @db.Char(36)
  purchaseOrderItemId String? @map("purchase_order_item_id") @db.Char(36)
  itemId          String  @map("item_id") @db.Char(36)
  quantityOrdered Decimal @map("quantity_ordered") @db.Decimal(18, 3)
  quantityReceived Decimal @map("quantity_received") @db.Decimal(18, 3)
  unitCost        Decimal @map("unit_cost") @db.Decimal(18, 2)
  position        Int     @db.SmallInt

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  item         Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)

  @@unique([goodsReceiptId, position], map: "uq_gr_item_position")
  @@map("goods_receipt_items")
}
