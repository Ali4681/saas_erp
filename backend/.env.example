PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Public base URL of this API (webhooks, links in emails, docs).
# Routes are under /api/* (see setGlobalPrefix in main.ts), e.g. https://host/api/auth/login
APP_URL=http://127.0.0.1:3000

# Comma-separated browser origins allowed to call the API (empty = reflect request origin in dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001,http://localhost:3370,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3370

# ---------------------------------------------------------------------------
# Database
# XAMPP MySQL (default): root with empty password on 3306
# Docker Compose: root/root or saas_erp/saas_erp on 3306 (see docker-compose.yml)
# Local MySQL 8.4 script: saas_erp/saas_erp on 3307 (npm run db:mysql:local)
# Nest runtime uses DATABASE_HOST/USER/PASSWORD/NAME; Prisma CLI uses DATABASE_URL.
#
# Plesk/production:
#   DATABASE_HOST=localhost   (not 127.0.0.1 — different MySQL user!)
#   DATABASE_USER / PASSWORD = the DB user from Plesk (not empty-password root)
#   Test: npm run db:ping
#   Migrate: npm run prisma:migrate
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://root:@127.0.0.1:3306/saas_erp"
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=saas_erp
DATABASE_CONNECTION_LIMIT=10
DATABASE_CONNECT_TIMEOUT=10000
SHADOW_DATABASE_URL="mysql://root:@127.0.0.1:3306/saas_erp_shadow"
# ---------------------------------------------------------------------------
# Redis + sync engine (integration jobs)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# auto | bullmq | inline — auto falls back to inline when Redis is down
SYNC_ENGINE_DRIVER=auto

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
ENCRYPTION_KEY_VERSION=1
ENCRYPTION_KEYS={"1":"MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="}
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30

# ---------------------------------------------------------------------------
# Retention (days)
# ---------------------------------------------------------------------------
RETENTION_CRON_ENABLED=true
RETENTION_AUDIT_DAYS=365
RETENTION_API_REQUEST_LOG_DAYS=90
RETENTION_WEBHOOK_DELIVERY_DAYS=90
RETENTION_WEBHOOK_EVENT_DAYS=90
RETENTION_MESSAGE_DELIVERY_DAYS=180
RETENTION_AI_USAGE_DAYS=365
RETENTION_INTEGRATION_ERROR_DAYS=180
RETENTION_AUTOMATION_RUN_DAYS=180

# ---------------------------------------------------------------------------
# File storage (attachments / product images)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage/uploads
# S3-compatible (optional — fill when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# AI Module 16.x (ENTERPRISE plan feature AI_ASSISTANT)
# Docs: https://platform.openai.com/docs
# ---------------------------------------------------------------------------
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Messaging / notifications (email + SMS via Brevo)
# Dashboard: https://app.brevo.com/settings/keys/api
# WhatsApp: use Meta Cloud API OR Brevo WhatsApp when approved
# ---------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3
BREVO_EMAIL_FROM=
BREVO_EMAIL_FROM_NAME=SaaS ERP
BREVO_SMS_SENDER=SaaSERP
SMTP_FROM=

# Meta WhatsApp Cloud API (optional alternative to Brevo WhatsApp)
WHATSAPP_PROVIDER=meta
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# Payment gateways (platform defaults; per-company keys also stored encrypted in DB)
# Stripe: https://dashboard.stripe.com/apikeys
# PayPal: https://developer.paypal.com/dashboard/
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
# Live: https://api-m.paypal.com

# ---------------------------------------------------------------------------
# Social marketing publishers 14.4 (OAuth apps — page tokens often per-company in DB)
# ---------------------------------------------------------------------------
# Facebook / Instagram Graph: https://developers.facebook.com/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_URL=https://graph.facebook.com/v21.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# LinkedIn Marketing: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_URL=https://api.linkedin.com/v2

# X (Twitter) API v2: https://developer.x.com/
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_API_BASE_URL=https://api.x.com/2

# TikTok Content Posting: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_API_BASE_URL=https://open.tiktokapis.com

# Google Business Profile: https://developers.google.com/my-business
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_API_BASE_URL=https://mybusinessbusinessinformation.googleapis.com

# ---------------------------------------------------------------------------
# Delivery platforms (Architecture Spec §3)
# Per ConnectedProject credentials stay ENCRYPTED in DB.
# Fill platform OAuth/app defaults here when you have partner apps.
# ---------------------------------------------------------------------------
# HungerStation Partner API — PUBLIC_DOCUMENTED
# Docs: https://developer.hungerstation.com/api-specifications
HUNGERSTATION_CLIENT_ID=
HUNGERSTATION_CLIENT_SECRET=
HUNGERSTATION_API_BASE_URL=
HUNGERSTATION_TOKEN_URL=
HUNGERSTATION_WEBHOOK_SECRET=

# Keeta — PUBLIC_DOCUMENTED (OAuth2 + NDA/SIT/UAT required)
KEETA_CLIENT_ID=
KEETA_CLIENT_SECRET=
KEETA_API_BASE_URL=
KEETA_TOKEN_URL=
KEETA_WEBHOOK_SECRET=

# Jahez Integration Portal — PARTNER_PORTAL (account-gated)
JAHEZ_CLIENT_ID=
JAHEZ_CLIENT_SECRET=
JAHEZ_API_BASE_URL=
JAHEZ_TOKEN_URL=
JAHEZ_WEBHOOK_SECRET=

# Ninja — PARTNER_PORTAL (DRIVER_CREATE hidden until documented)
NINJA_CLIENT_ID=
NINJA_CLIENT_SECRET=
NINJA_API_BASE_URL=
NINJA_TOKEN_URL=
NINJA_WEBHOOK_SECRET=

# Mrsool — PRIVATE_CONFIRMED (partner contract only)
MRSOOL_CLIENT_ID=
MRSOOL_CLIENT_SECRET=
MRSOOL_API_BASE_URL=
MRSOOL_TOKEN_URL=
MRSOOL_WEBHOOK_SECRET=

# The Chefz / ToYou / Shgardi — UNVERIFIED_PUBLICLY (placeholders)
THE_CHEFZ_API_BASE_URL=
THE_CHEFZ_API_KEY=
TOYOU_API_BASE_URL=
TOYOU_API_KEY=
SHGARDI_API_BASE_URL=
SHGARDI_API_KEY=

# ---------------------------------------------------------------------------
# Installment platforms
# ---------------------------------------------------------------------------
# Tabby — PUBLIC_DOCUMENTED https://docs.tabby.ai/
TABBY_SECRET_KEY=
TABBY_PUBLIC_KEY=
TABBY_MERCHANT_CODE=
TABBY_API_BASE_URL=https://api.tabby.ai/api/v2
TABBY_WEBHOOK_SECRET=

# Tamara — PUBLIC_DOCUMENTED https://docs.tamara.co/
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=
TAMARA_API_BASE_URL=https://api.tamara.co
TAMARA_WEBHOOK_SECRET=

# MIS Pay — PUBLIC_DOCUMENTED (checkout/tracking)
MISPAY_API_KEY=
MISPAY_MERCHANT_ID=
MISPAY_API_BASE_URL=
MISPAY_WEBHOOK_SECRET=

# Madfu / Emkan — pending official packages
MADFU_API_BASE_URL=
MADFU_API_KEY=
EMKAN_API_BASE_URL=
EMKAN_API_KEY=
EMKAN_CLIENT_ID=
EMKAN_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# E-commerce platforms
# ---------------------------------------------------------------------------
# Zid — PUBLIC_DOCUMENTED https://docs.zid.sa/
ZID_CLIENT_ID=
ZID_CLIENT_SECRET=
ZID_API_BASE_URL=https://api.zid.sa/v1
ZID_TOKEN_URL=
ZID_WEBHOOK_SECRET=

# Salla — PUBLIC_DOCUMENTED https://docs.salla.dev/
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_API_BASE_URL=https://api.salla.dev/admin/v2
SALLA_TOKEN_URL=https://accounts.salla.sa/oauth2/token
SALLA_WEBHOOK_SECRET=

# WooCommerce — store URL + keys often per ConnectedProject; platform defaults optional
WOOCOMMERCE_STORE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_API_VERSION=wc/v3
WOOCOMMERCE_WEBHOOK_SECRET=

# Shopify — PUBLIC_DOCUMENTED https://shopify.dev/docs/api
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_customers,read_inventory,write_inventory
SHOPIFY_API_VERSION=2025-01
SHOPIFY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Push notifications (Firebase Cloud Messaging)
# Console: https://console.firebase.google.com/
# Prefer env vars (never commit real keys). JSON path is optional fallback.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Wrap private key in double quotes; keep \n escapes
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT_PATH=
# Web / mobile client config (frontend)
FIREBASE_WEB_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# true = log-only stub (no real FCM HTTP calls)
FCM_DRY_RUN=true

# ---------------------------------------------------------------------------
# Notes
# - Leave keys empty until you have real credentials; adapters use LOCAL_STUB / disabled caps.
# - Tenant/provider secrets for a specific ConnectedProject belong in DB (encrypted), not here.
# - Fill OPENAI_API_KEY + BREVO_API_KEY first for AI + email/SMS in demos.
# - Notifications / FCM: you own Firebase wiring; backend only reserves FIREBASE_* placeholders.
# ---------------------------------------------------------------------------
